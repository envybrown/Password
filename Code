/* This program will ask the user to enter a password that contains:
At least eight (8) characters, including at least one number, 
at least one upper case letter, and at least one lower case letter. */

#include <iostream>
#include <string>
#include <cctype>

using namespace std;

string pass1;
string pass2; // make passwords global

void instructions(); // print password requirements 
void password1(); // password creation
void password2(); // password confirmation

int main()
{
    instructions();
    password1();
    password2(); // functions in order
    
    return 0;
}

void instructions(){
    cout << "Create a password. Your password must include: " << endl;
    cout << "At least eight characters." << endl;
    cout << "At least one number." << endl;
    cout << "At least one uppercase letter." << endl;
    cout << "At least one lowercase letter." << endl;
}

void password1(){
    
    bool hasUpper = false;
    bool hasLower = false;
    bool hasNumber = false; // defines isuppper, islower, isdigit
    
    do {
        hasUpper = false;
        hasLower = false;
        hasNumber = false; // resets to false
    
        cout << "\nEnter password: ";
        getline (cin, pass1);
        
        for (char c : pass1){
            if(isupper(c)){
                hasUpper = true;
            }
            if(islower(c)){
                hasLower = true;
            }
            if(isdigit(c)){
                hasNumber = true;
            }
        } // loops through each character for upper, lower, and digits
         
        if (pass1.length()<8 || hasUpper == false || hasLower == false || hasNumber == false){
            cout << "Invalid password. Missing:\n";
            
            if (pass1.length()<8){
                cout << "At least eight characters.\n";
            }
            
            if (hasUpper == false){
                cout << "At least one uppercase letter.\n";
            }
            
            if (hasLower == false){
                cout << "At least one lowercase letter.\n";
            }
            
            if (hasNumber == false){
                cout << "At least one number.\n";
            } // states what is missing if definitions are false
            
        }
        
    } while (!(hasUpper == true && hasLower == true && hasNumber == true && pass1.length() >= 8)); // loop until everything is true
}

void password2(){
    do {
        cout << "\nRe-enter password: ";
        getline (cin, pass2);
        
        if (pass2 != pass1){
            cout << "Password does not match. Please try again.\n";
        } // compare pass2 to pass1
        
    } while (!(pass2 == pass1)); // loop statement until paswords match 
    
    cout << "\nPassword is valid.";
}
